# PostgreSQL (로컬 개발 예시)
DB_URL=jdbc:postgresql://localhost:5432/mallota
DB_USERNAME=mallota
DB_PASSWORD=change-this-password
# 개발 환경에서는 update, 운영 환경에서는 validate 또는 마이그레이션 도구 사용을 권장합니다.
JPA_DDL_AUTO=update

# 음성 인식(STT) 공급자 선택: IBM(기본값) 또는 CLOVA
STT_PROVIDER=IBM

# 네이버 CLOVA Speech (장문 인식) — NCP 콘솔의 "CLOVA Speech" 앱에서 발급
# STT_PROVIDER=CLOVA 일 때만 사용됨
CLOVA_STT_ENABLED=false
CLOVA_STT_SECRET=
CLOVA_STT_INVOKE_URL=
